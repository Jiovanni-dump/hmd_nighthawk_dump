    <privapp-permissions package="com.hmd.face.service">
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <permission name="android.permission.INTERACT_ACROSS_PROFILES"/>
    </privapp-permissions>
    <!-- Added by changqing for face unlock  end-->
    <!-- Added by eddie.chen for [FSW-019] Device Activation. 2024.01.30 begin -->
