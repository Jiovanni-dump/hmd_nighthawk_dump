        <permission name="android.permission.MANAGE_USERS"/>
        <permission name="android.permission.DISPATCH_PROVISIONING_MESSAGE"/>
    </privapp-permissions>

    <!--add by xiaomin.zheng for TCT-2170:HMD Widget_Weather  2024.2.28 start-->
