                <etc status="enable" etclocation="product" etctype="permissions" etcpath="permission_ignite_com.dti.hmdglobal.xml" packageName="com.dti.hmdglobal"></etc>
                <etc status="enable" etclocation="product" etctype="default-permissions" etcpath="default-permissions-com.dti.hmdglobal.xml" packageName="com.dti.hmdglobal"></etc>
            </etc-list>
