            <apk status="enable" apptype="system-app" apppath="PlayAutoInstallStub" packageName="android.autoinstalls.config.hmdglobal.nighthawk"></apk>
            <apk status="enable" apptype="system-app" apppath="GmsSampleIntegration" packageName="com.hmdglobal.android.gmsintegration"></apk>
            <apk status="enable" apptype="product-priv-app" apppath="Omacp" packageName="com.hmdglobal.app.omacp"></apk>
        </apk-list>
        <sub-config skuid="100IN">
